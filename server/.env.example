# ===== PC 抖音服务端环境变量模板 =====
# 复制为 server/.env 后按需修改；所有能力按以下开关降级：
#   - 只填 PORT/JWT_SECRET/DATABASE_URL(sqlite) → 与当前开发环境一致
#   - DATABASE_URL 换 postgres → 搜索启用 insensitive（需跑 db:migrate:pg + db:generate:pg）
#   - JWT_REFRESH_ENABLED=true → access/refresh 双令牌 + 轮换 + 登出黑名单
#   - REDIS_URL → 资料计数/未读数缓存（无 Redis 时自动 no-op）
#   - S3_BUCKET → 上传走 S3 兼容存储 + /media Range 代理（无则本地 uploads/）

# --- 基础 ---
PORT=3000
JWT_SECRET=change-me-in-prod

# --- 数据库（二选一）---
# SQLite（开发默认）
DATABASE_URL=file:./dev.db
# Postgres（生产，配合 docker-compose.yml 的 db 服务）
# DATABASE_URL=postgresql://pcdouyin:pcdouyin@localhost:5432/pcdouyin

# --- JWT 双令牌（可选，默认关闭=单 7d access）---
JWT_REFRESH_ENABLED=true
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Redis 缓存（可选，默认关闭=no-op）---
REDIS_URL=redis://localhost:6379

# --- S3 兼容对象存储（可选，默认关闭=本地 uploads/）---
# 设置 S3_BUCKET 即启用；配合 docker-compose.yml 的 minio 服务
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=pcdouyin
S3_SECRET_ACCESS_KEY=pcdouyin-secret
S3_BUCKET=pcdouyin
